                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
    City,
    State,
    Country,
    CAST(ISNULL(CAST(PostalCode AS VARCHAR(20)), '') AS VARCHAR(20)) AS PostalCode,
    CAST(Market AS VARCHAR(10)) AS Market,
    CAST(Region AS VARCHAR(30)) AS Region
